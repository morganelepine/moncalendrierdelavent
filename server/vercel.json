{
    "version": 2,
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/src/index.ts"
        }
    ],
    "schedules": {
        "reminder-christmas-morning": {
            "schedule": "0 8 1-25 12 *",
            "path": "/notifications/send-daily-reminder",
            "requestMethod": "GET"
        },
        "reminder-halloween-morning": {
            "schedule": "0 7 * 10 *",
            "path": "/notifications/send-daily-reminder",
            "requestMethod": "GET"
        },
        "reminder-christmas-evening": {
            "schedule": "0 17 1-25 12 *",
            "path": "/notifications/send-daily-reminder",
            "requestMethod": "GET"
        },
        "reminder-halloween-evening": {
            "schedule": "0 16 * 10 *",
            "path": "/notifications/send-daily-reminder",
            "requestMethod": "GET"
        },
        "retrospective-compute": {
            "schedule": "0 23 24-25 12 *",
            "path": "/retrospective/compute",
            "requestMethod": "GET"
        }
    }
}
